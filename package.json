  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "video:test": "tsx src/automation/main.ts --codex-test --input ./inputs/ml-engineering.md",
    "videos": "tsx src/automation/main.ts",
    "video:url": "tsx src/automation/main.ts --source",
    "video:preview": "tsx src/automation/main.ts --preview --codex-test --input ./inputs/ml-engineering.md",
    "video:validate": "tsx src/automation/main.ts --validate --input ./inputs/ml-engineering.md",
    "test:automation": "tsx --test src/automation/*.test.ts",
    "ui": "npm run build:ui && node dist/server.cjs",
    "ui:offline": "npm run build:ui && node dist/server.cjs --offline",
    "build:ui": "vite build && node scripts/build-server.mjs",
    "test:phase5": "tsx --test src/server/*.test.ts",
    "test:ui": "playwright test"
  },
  "sideEffects": [
    "*.css"
  ]
